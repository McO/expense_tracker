# Copy to tool/release.local.env (gitignored) and fill in. Both values enable the
# Firebase App Distribution upload in tool/release.sh; leave the file out to skip it.
# Use a tester GROUP alias from the Firebase console, never an email address.
FIREBASE_APP_ID=1:000000000000:android:0000000000000000
FIREBASE_TESTER_GROUP=your-group-alias
